generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// Как набран пул сессии. Не путать с Question.difficulty (там MIXED нет).
/// SINGLE + difficulty EASY|MEDIUM|HARD; MIXED + difficulty NULL.
/// CHECK в миграции. Исторические строки = SINGLE. Canon: Mixed-difficulty quiz.
enum QuizSessionPoolKind {
  SINGLE
  MIXED
}

enum QuizSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ContentLocale {
  ru
  en
}

enum QuestionType {
  TEXT
  IMAGE_GUESS
  /// Клип 6–8 с (PROMPT asset, audio/mpeg). DECISIONS → Audio questions: AUDIO_GUESS.
  AUDIO_GUESS
}

enum QuestionAssetRole {
  PROMPT
  HINT
  THUMBNAIL
}

/// Жизненный цикл контента вопроса (отдельно от soft-hide `isActive`).
/// Quiz pool берёт только PUBLISHED + isActive=true. См. DECISIONS → Question publication workflow.
enum QuestionPublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  /// NULL — вход без почты: VK ID не поделился email, у гостя почты нет.
  /// Вход по паролю ищет по равенству, поэтому NULL никогда не совпадёт.
  /// Canon: DECISIONS → Accounts without a password.
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?
  role          Role      @default(USER)
  image         String?
  isActive      Boolean   @default(true)
  /// Служебный аккаунт (прод-smoke после деплоя): играет как обычный игрок,
  /// но не попадает в рейтинги. Ставится скриптом mark-test-account.cjs.
  isTestAccount Boolean   @default(false)
  /// Гость: играет без регистрации, скрыт из рейтингов. При регистрации
  /// та же строка становится обычным аккаунтом (isGuest = false).
  isGuest       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  quizSessions        QuizSession[]
  quizResults         QuizResult[]
  userAchievements    UserAchievement[]
  achievementOutbox   AchievementOutbox[]
  /// Мешок анти-повтора вопросов (Classic/Timed) по сложности. Daily не использует.
  questionCycles      UserQuestionCycle[]
  /// Мешки анти-повтора тем игры (Classic/Timed с выбранной темой).
  topicQuestionCycles UserTopicQuestionCycle[]
  /// Забеги Survival (волны = отдельные QuizSession). Classic/Blitz/Daily сюда не пишут.
  survivalRuns        SurvivalRun[]
  /// Вызовы другу, созданные игроком из своих партий Классики.
  friendChallenges    FriendChallenge[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Общий счётчик rate limit (фиксированное окно) для всех инстансов Vercel.
/// Пишется только сырым SQL из src/lib/rate-limit-shared.ts (атомарный upsert).
/// Просроченные строки чистятся там же; IP в ключе живёт не дольше окна.
model RateLimitBucket {
  /// `preset:identity`, например `auth:ip:203.0.113.7` или `password:user:<id>`.
  key     String   @id
  count   Int
  /// timestamptz: сравнение в сыром SQL не зависит от часового пояса сессии.
  resetAt DateTime @db.Timestamptz(3)

  @@index([resetAt])
}

model Question {
  id                String                    @id @default(cuid())
  text              String
  type              QuestionType              @default(TEXT)
  difficulty        Difficulty
  /// Устаревшее: всегда "video-games". Домен — `domainId`; колонку удалит
  /// отдельная миграция, когда код перестанет её писать (ADR Content taxonomy).
  category          String                    @default("video-games")
  /// Домен контента (игры, позже фильмы, футбол…). Домен — данные, не ветки кода.
  domainId          String                    @default("games")
  /// Стабильный ключ контента, одинаковый на dev и prod: draftKey партии или
  /// детерминированный id сида. id вопросов из импорта в базах разные.
  contentKey        String?                   @unique
  metadata          Json?
  /// Soft-hide / архив: false → никогда не в quiz pool (даже если PUBLISHED).
  isActive          Boolean                   @default(true)
  /// Черновик → ревью → публикация. Новые вопросы = DRAFT; в pool только PUBLISHED.
  publicationStatus QuestionPublicationStatus @default(DRAFT)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  options          AnswerOption[]
  assets           QuestionAsset[]
  quizAnswers      QuizAnswer[]
  sessionQuestions QuizSessionQuestion[]
  translations     QuestionTranslation[]
  /// Exclusion ids Survival-забега (wave 2+). Не JSONB на run.
  survivalRunSeen  SurvivalRunSeenQuestion[]
  tags             QuestionTag[]

  domain Domain @relation(fields: [domainId], references: [id])

  @@index([difficulty, isActive, publicationStatus])
}

/// Таксономия контента: домен → измерение (Facet) → метка (Tag) ↔ вопрос.
/// Справочники заполняет `scripts/taxonomy-sync.cjs` из content/taxonomy;
/// частые фильтры — здесь, а не в `Question.metadata` (JSONB).
/// Canon: docs/DECISIONS.md → Content taxonomy.

/// Домен контента. id — стабильный slug (`games`): его видят URL и каталог.
model Domain {
  id        String   @id
  nameRu    String
  nameEn    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  questions Question[]
  facets    Facet[]
}

/// Измерение меток внутри домена: платформа, эпоха, жанр, франшиза, игра.
/// id = `{domainId}.{slug}` (`games.platform`).
model Facet {
  id        String @id
  domainId  String
  slug      String
  nameRu    String
  nameEn    String
  sortOrder Int    @default(0)

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  tags   Tag[]

  @@unique([domainId, slug])
}

/// Значение измерения: `PS2`, `90-е`, `Шутер`, `Resident Evil`.
/// id = `{facetId}.{slug}` (`games.platform.ps2`) — одинаков на dev и prod.
/// parentId — семейство внутри того же измерения (PS2 → PlayStation).
model Tag {
  id        String   @id
  facetId   String
  slug      String
  nameRu    String
  nameEn    String
  parentId  String?
  sortOrder Int      @default(0)
  /// Место в выборе темы игры (шторка режима); NULL — метка не тема.
  /// Пишет taxonomy:sync из `playTopics` каталога.
  playOrder Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facet        Facet                    @relation(fields: [facetId], references: [id], onDelete: Cascade)
  parent       Tag?                     @relation("TagFamily", fields: [parentId], references: [id], onDelete: SetNull)
  children     Tag[]                    @relation("TagFamily")
  questions    QuestionTag[]
  topicCycles  UserTopicQuestionCycle[]
  /// Сессии, сыгранные с этой темой. Restrict: тему с историей не удалить.
  quizSessions QuizSession[]

  @@unique([facetId, slug])
  @@index([parentId])
}

/// Метка вопроса. Индекс (tagId, questionId) — под выборку «вопросы с меткой».
model QuestionTag {
  questionId String
  tagId      String
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId, questionId])
}

model AnswerOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question               Question                    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quizAnswers            QuizAnswer[]
  sessionQuestionOptions QuizSessionQuestionOption[]
  translations           AnswerOptionTranslation[]

  @@index([questionId])
}

/// Общий набор вопросов на один календарный день (Daily Challenge MVP).
/// `challengeDate` = DATE (день без времени); `questionIds` freeze при создании.
/// См. DECISIONS.md → Daily Challenge MVP; feature types в daily-challenge/types.ts.
/// «Вызов другу»: замороженный набор вопросов партии автора + его результат.
/// Друг играет те же вопросы (варианты перемешаны заново), одна попытка.
/// Результат автора скопирован: страница вызова читает одну строку и живёт,
/// даже если аккаунт автора удалён. Canon: DECISIONS → Friend challenge.
model FriendChallenge {
  /// Короткий случайный id — часть ссылки `/challenge/{id}`.
  id                  String              @id
  /// NULL — аккаунт автора удалён (вызов и чужие попытки остаются).
  creatorUserId       String?
  /// Партия автора; UNIQUE — повторное нажатие отдаёт ту же ссылку.
  sourceSessionId     String?             @unique
  /// SINGLE: сложность партии. MIXED: NULL.
  difficulty          Difficulty?
  poolKind            QuizSessionPoolKind
  questionCount       Int
  /// JSON-массив question id в порядке партии автора; не меняется.
  questionIds         Json
  creatorScore        Int
  creatorCorrectCount Int
  /// JSON-массив boolean «верно / нет» автора в том же порядке.
  creatorMarks        Json
  createdAt           DateTime            @default(now())

  creator       User?         @relation(fields: [creatorUserId], references: [id], onDelete: SetNull)
  sourceSession QuizSession?  @relation("FriendChallengeSource", fields: [sourceSessionId], references: [id], onDelete: SetNull)
  attempts      QuizSession[] @relation("FriendChallengeAttempts")

  @@index([creatorUserId])
}

model DailyChallenge {
  id            String     @id @default(cuid())
  /// Календарный день челленджа (приложение пишет Moscow YYYY-MM-DD как DATE).
  challengeDate DateTime   @unique @db.Date
  difficulty    Difficulty
  questionCount Int
  /// JSON-массив question id в порядке квиза; не менять после первой записи дня.
  questionIds   Json
  createdAt     DateTime   @default(now())

  sessions QuizSession[]
}

/// Забег Survival: скаляры банка/волны/total, без JSONB.
/// Одна волна = один QuizSession (обычно 12; последняя может быть 1..11).
/// Волна 2+ — новая сессия + exclusion seen, не рост TOAST.
/// Дискриминатор сессии: `survivalRunId IS NOT NULL`. `timedEndsAt` и `dailyChallengeId` запрещены CHECK.
/// Canon: docs/DECISIONS.md → Survival Mode MVP. Не мержить с Timed (`timedEndsAt`).
model SurvivalRun {
  id                   String            @id @default(cuid())
  userId               String
  /// Только EASY|MEDIUM|HARD. Mix в MVP нет.
  difficulty           Difficulty
  /// Тот же enum, что у сессии (IN_PROGRESS / COMPLETED / ABANDONED) — без второго типа.
  status               QuizSessionStatus @default(IN_PROGRESS)
  currentWaveIndex     Int               @default(1)
  startedAt            DateTime          @default(now())
  completedAt          DateTime?
  /// Остаток банка после успешного complete волны. Скаляр на run, не JSONB и не per-answer UPDATE.
  bankRemainingSeconds Int?
  /// Сумма score волн с survivalClockOk=true. Доска = best run per user по этому скаляру.
  /// Пишется pooled AFTER complete (не в completeWithResult). Wave clockOk=false не добавляет.
  totalScore           Int               @default(0)

  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      QuizSession[]
  seenQuestions SurvivalRunSeenQuestion[]

  @@index([userId, status])
  /// Leaderboard ?mode=survival: best totalScore per user.
  @@index([totalScore])
}

/// Exclusion ids внутри одного SurvivalRun (без повторов между волнами).
/// Live pool = isActive+PUBLISHED+difficulty минус эти строки.
/// Не класть массив ids в SurvivalRun / completeWithResult (TOAST / hot path).
/// Canon: docs/DECISIONS.md → Survival Mode MVP (wave 2+).
model SurvivalRunSeenQuestion {
  runId      String
  questionId String

  run      SurvivalRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([runId, questionId])
  @@index([questionId])
}

model QuizSession {
  id                String              @id @default(cuid())
  userId            String
  status            QuizSessionStatus   @default(IN_PROGRESS)
  /// SINGLE: EASY|MEDIUM|HARD. MIXED: NULL (не маскировать mix под MEDIUM).
  difficulty        Difficulty?
  /// SINGLE = один мешок; MIXED = сплит трёх мешков. Default покрывает legacy INSERT.
  poolKind          QuizSessionPoolKind @default(SINGLE)
  questionCount     Int
  sessionLocale     ContentLocale       @default(ru)
  snapshotData      Json?
  /// NULL = classic quiz; non-null = попытка Daily Challenge.
  dailyChallengeId  String?
  /// NULL = classic/daily; non-null = Timed mode (серверный дедлайн submit).
  /// Canon: docs/DECISIONS.md → Timed Mode MVP.
  timedEndsAt       DateTime?
  /// NULL = не Survival; non-null = волна SurvivalRun.
  /// Classic = dailyChallengeId, timedEndsAt и survivalRunId все NULL.
  /// CHECK в миграции: Survival ⇏ timedEndsAt / dailyChallengeId (не Blitz, не Daily).
  /// Canon: docs/DECISIONS.md → Survival Mode MVP.
  survivalRunId     String?
  /// Номер волны внутри run. NULL если не Survival. Волна 1 MVP = 1.
  survivalWaveIndex Int?
  /// Реконструкция банка на submit. NULL до complete / если не Survival.
  survivalClockOk   Boolean?
  /// Тема игры (Tag с playOrder): вопросы только с этой меткой или её детьми.
  /// NULL = весь банк. Сессии с темой не идут в общий рейтинг.
  /// Canon: docs/DECISIONS.md → Play topics.
  topicTagId        String?
  /// NULL = не вызов; non-null = попытка «Вызова другу» (те же вопросы, что у
  /// автора). Такие игры не идут в рейтинг. Canon: DECISIONS → Friend challenge.
  friendChallengeId String?
  startedAt         DateTime            @default(now())
  completedAt       DateTime?

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicTag          Tag?                  @relation(fields: [topicTagId], references: [id], onDelete: Restrict)
  dailyChallenge    DailyChallenge?       @relation(fields: [dailyChallengeId], references: [id], onDelete: Restrict)
  survivalRun       SurvivalRun?          @relation(fields: [survivalRunId], references: [id], onDelete: Restrict)
  friendChallenge   FriendChallenge?      @relation("FriendChallengeAttempts", fields: [friendChallengeId], references: [id], onDelete: Restrict)
  /// Вызов, созданный из этой партии (одна партия — один вызов).
  challengeFromHere FriendChallenge?      @relation("FriendChallengeSource")
  answers           QuizAnswer[]
  result            QuizResult?
  sessionQuestions  QuizSessionQuestion[]

  /// Одна сессия на пользователя на день челленджа.
  /// Postgres: несколько строк с dailyChallengeId NULL допустимы (classic).
  @@unique([userId, dailyChallengeId])
  /// Один вызов — одна попытка игрока (как Челлендж дня).
  @@unique([userId, friendChallengeId])
  @@index([userId, status])
  @@index([friendChallengeId])
  @@index([dailyChallengeId])
  @@index([survivalRunId])
  /// Leaderboard: MIXED vs SINGLE+difficulty, без UNION.
  @@index([poolKind, difficulty])
}

model QuizAnswer {
  id               String   @id @default(cuid())
  sessionId        String
  questionId       String
  selectedOptionId String
  isCorrect        Boolean
  answeredAt       DateTime @default(now())

  session        QuizSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption AnswerOption @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
}

model QuizResult {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  userId         String
  score          Int
  totalQuestions Int
  correctCount   Int
  completedAt    DateTime @default(now())
  /// Копия snapshot на момент complete — legacy fallback для review, если нет reviewPayload.
  /// См. DECISIONS → Quiz Start / Session Load Playbook (result incident).
  reviewSnapshot Json?
  /// Slim bilingual review DTO (option B): пишется на submit из уже загруженного
  /// snapshot; hot-path разбора читает его вместо большого reviewSnapshot/TOAST.
  reviewPayload  Json?
  /// Засчитанное сервером «окно прослушивания» (мс); рекорд Блица = elapsed − это.
  clockCreditMs  Int      @default(0)

  session QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([score(sort: Desc), completedAt(sort: Asc)])
}

/// Намерение award после completed QuizResult (transactional outbox, MVP).
/// Пишется на том же Direct write-client, что answers/result/COMPLETED.
/// Processor / profile catch-up / result Suspense — идемпотентно; не блокирует submit UX.
/// Canon: docs/DECISIONS.md → Achievements MVP + result incident Aug 4.
model AchievementOutbox {
  id          String    @id @default(cuid())
  userId      String
  sessionId   String    @unique
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([processedAt, createdAt])
  @@index([userId])
}

/// Факт разблокировки бейджа у пользователя (Achievements MVP, вариант A).
/// Каталог и критерии — в коде (`ACHIEVEMENT_CATALOG`); здесь только unlock.
/// `code` стабилен; тексты — i18n. См. DECISIONS.md → Achievements MVP.
/// Будущие домены (movies/football/…): новые коды или опциональный scope — не сейчас.
model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  /// Стабильный slug из feature-каталога (например FIRST_QUIZ).
  code       String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
}

/// Shuffle-bag анти-повтора: один мешок на (user, difficulty) для Classic + Timed.
/// Храним только скаляры (seed + cursor + poolSize) — не JSON-массив id.
/// Толстый remainingIds JSONB на Neon/Prisma зависал >4s → fallback random и «повторы».
/// Daily Challenge эту таблицу не трогает. Пишем только на quiz start, не на submit.
/// Canon: User Question Cycle MVP (seeded cursor).
model UserQuestionCycle {
  id          String     @id @default(cuid())
  userId      String
  difficulty  Difficulty
  /// Номер цикла (увеличивается при reshuffle).
  cycleNumber Int        @default(0)
  /// Seed детерминированного shuffle отсортированного pool.
  cycleSeed   Int        @default(0)
  /// Следующий индекс в shuffled pool.
  cursor      Int        @default(0)
  /// Размер pool на старте цикла; смена размера → новый цикл.
  poolSize    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, difficulty])
  @@index([userId])
}

/// Мешок анти-повтора темы игры: один на (user, тема, difficulty), та же
/// seeded-cursor механика, что UserQuestionCycle. Отдельная таблица, а не
/// колонка там: смена UNIQUE (userId, difficulty) сломала бы ON CONFLICT
/// работающего кода между миграцией и деплоем.
/// Canon: docs/DECISIONS.md → Play topics.
model UserTopicQuestionCycle {
  id          String     @id @default(cuid())
  userId      String
  tagId       String
  difficulty  Difficulty
  cycleNumber Int        @default(0)
  cycleSeed   Int        @default(0)
  cursor      Int        @default(0)
  poolSize    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId, difficulty])
  @@index([tagId])
}

model QuizSessionQuestion {
  id              String  @id @default(cuid())
  sessionId       String
  questionId      String
  position        Int
  displayText     String?
  displayImageUrl String?

  session  QuizSession                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question                    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  options  QuizSessionQuestionOption[]

  @@unique([sessionId, questionId])
  @@unique([sessionId, position])
  @@index([sessionId])
}

model QuestionAsset {
  id         String            @id @default(cuid())
  questionId String
  role       QuestionAssetRole @default(PROMPT)
  url        String
  storageKey String?
  mimeType   String?
  width      Int?
  height     Int?
  byteSize   Int?
  order      Int               @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, role])
}

model QuizSessionQuestionOption {
  id                String  @id @default(cuid())
  sessionQuestionId String
  optionId          String
  displayOrder      Int
  displayText       String?

  sessionQuestion QuizSessionQuestion @relation(fields: [sessionQuestionId], references: [id], onDelete: Cascade)
  option          AnswerOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([sessionQuestionId, optionId])
  @@unique([sessionQuestionId, displayOrder])
  @@index([sessionQuestionId])
}

model QuestionTranslation {
  id         String        @id @default(cuid())
  questionId String
  locale     ContentLocale
  text       String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, locale])
  @@index([locale])
}

model AnswerOptionTranslation {
  id       String        @id @default(cuid())
  optionId String
  locale   ContentLocale
  text     String

  option AnswerOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, locale])
  @@index([locale])
}
