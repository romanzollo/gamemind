# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions


# testing
/coverage
# Playwright: reports, screenshots and the saved smoke-player session (auth cookie)
/test-results/
/test-results-private/
/playwright-report/
/blob-report/
/e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Chat session diary (rolling "Last Session" log) — keep local only
docs/PROJECT_CONTEXT.md

# raw screenshot sources before WebP optimize (keep structure + README)
/raw-quiz-images/**
!/raw-quiz-images/README.md
!/raw-quiz-images/**/.gitkeep

# AUDIO_GUESS: исходники клипов и страницы ревью — только локально.
# Клипы не попадают в git (репозиторий публичный, права): прод — Vercel Blob.
/raw-quiz-audio/**
!/raw-quiz-audio/README.md

# «А ты знал?»: HTML-ревью партий фактов (`npm run facts:review`) — только локально.
/content/drafts/facts/_review/

# Local media uploads (STORAGE_PROVIDER=local-public) — do not commit runtime files
/public/media/**
!/public/media/.gitkeep

